# Template: fill in on the server, but never commit filled-in values. Blank values keep the defaults (compose or conf/config-<profile>.json).
# carp-webservices stack profile: local, development, production, ... (network, containers, image tag, queue names)
PROFILE=
# Gardener config file conf/config-<profile>.json: local or prod
CONFIG_PROFILE=
# Same ADMIN_USER / ADMIN_PASSWORD as the carp-webservices .env: the credentials of its PostgreSQL and RabbitMQ
ADMIN_USER=
ADMIN_PASSWORD=
# Database Gardener uses (and creates) in the shared PostgreSQL; default gardener
POSTGRES_DB=
POSTGRES__POOL__MAX_SIZE=

# Vendors: callback URIs are required in the prod profile for every vendor with credentials, e.g.
# https://<host>/gardener/api/oauth/fitbit/callback and https://<host>/gardener/api/collection/withings

# Fitbit
FITBIT__CLIENT__ID=
FITBIT__CLIENT__SECRET=
FITBIT__CLIENT__SUBSCRIPTION__CODE=
FITBIT__CLIENT__CALLBACK__URI=

# Withings
WITHINGS__CLIENT__ID=
WITHINGS__CLIENT__SECRET=
WITHINGS__CLIENT__CALLBACK__URI=
WITHINGS__CLIENT__COLLECTION__CALLBACK__URI=

# Dexcom
DEXCOM__CLIENT__ID=
DEXCOM__CLIENT__SECRET=
DEXCOM__CLIENT__CALLBACK__URI=

# Garmin (OAuth 1.0)
GARMIN__CONSUMER__KEY=
GARMIN__CONSUMER__SECRET=
GARMIN__CLIENT__CALLBACK__URI=
